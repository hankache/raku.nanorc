ing|trans|tree|trim|truncate|trusts|try_acquire|trying|twigil|type|type_captures|type_check|type_check_parents|type_suggestion|typed_exception|typename|uc|udp|uid|uint|uint16|uint32|uint64|uint8|uncaught_handler|unexpected|unimatch|uniname|uninames|uninstall|uniparse|uniprop|uniprops|unique|unit|unival|univals|unk_routines|unk_types|unlink|unlock|unpack|unpolar|unset|unshift|untyped|unwrap|updir|upper|usage|use|user|using|utc|value|values|valuetype|var|variable|variable_name|varname|vartype|ver|version|volume|vow|w|wait|watch|wb|week|what|whatever|when|where|why|willdo|wipe_conc_cache|word|wordcase|words|workaround|worries|wrap|write|wrong_body_result|ws|ww|x|xdigit|year|yield|z|zip)\>"

# Versions
color yellow "\<v[0-9]+(\.([0-9]+|\*|[a-z]\>))*(\.PREVIEW\>)?\+?"

# Kebab-case identifiers are not any of the words above
color normal "(\.[=^?]?)?[[:alpha:]_][[:alnum:]_]*(['-][[:alpha:]_][[:alnum:]_]*)+"

# Neither are named arguments and pair keys
color normal ":!?[[:alpha:]_][[:alnum:]_-]*"
color normal "\<[[:alpha:]_][[:alnum:]_'-]*[[:space:]]*=>"

# Types: any capitalised name
color cyan "\<[A-Z][[:alnum:]_]+(-[[:alpha:]_][[:alnum:]_]*)*"

# Phasers
color brightmagenta "\<(BEGIN|CHECK|INIT|END|CLOSE|ENTER|LEAVE|KEEP|UNDO|PRE|POST|FIRST|NEXT|LAST|CATCH|CONTROL|QUIT|DOC)\>"

# Capitalised and hyphenated traits and pragmas
color yellow "\<(DEPRECATED|hidden-from-backtrace|implementation-detail|test-assertion)\>"
color yellow "\<MONKEY(-[A-Z]+)*\>"

# Booleans and other terms
color yellow "\<(True|False|Empty|Inf|NaN)\>"

# Types: names with a namespace, then the builtin ones
color cyan "\<[A-Z][[:alnum:]_]*(::[[:alpha:]_][[:alnum:]_]*)+"
color brightcyan "\<(AST|Allomorph|Any|Array|Array::Shaped|Array::Shaped1|Array::Shaped2|Array::Shaped3|Array::Slice|Array::Slice::Access|Array::Slice::Assign|Array::Slice::Bind|Array::Typed|Associative|Attribute|Awaitable|Awaitable::Handle|Awaiter|Backtrace|Backtrace::Frame|Bag|BagHash|Baggy|Blob|Block|Bool|Buf|CX|CX::Done|CX::Emit|CX::Last|CX::Next|CX::Proceed|CX::Redo|CX::Return|CX::Succeed|CX::Take|CX::Warn|CallFrame|Callable|Cancellation|Capture|Channel|Code|Collation|CompUnit|CompUnit::DependencySpecification|CompUnit::Handle|CompUnit::Loader|CompUnit::PrecompilationDependency|CompUnit::PrecompilationDependency::File|CompUnit::PrecompilationId|CompUnit::PrecompilationRepository|CompUnit::PrecompilationRepository::Default|CompUnit::PrecompilationStore|CompUnit::PrecompilationStore::File|CompUnit::PrecompilationStore::FileSystem|CompUnit::PrecompilationUnit|CompUnit::PrecompilationUnit::File|CompUnit::Repository|CompUnit::Repository::AbsolutePath|CompUnit::Repository::Distribution|CompUnit::Repository::FileSystem|CompUnit::Repository::Installable|CompUnit::Repository::Installation|CompUnit::Repository::Locally|CompUnit::Repository::NQP|CompUnit::Repository::Perl5|CompUnit::Repository::Spec|CompUnit::Repository::Unknown|CompUnit::RepositoryRegistry|Compiler|Complex|ComplexStr|ContainerDescriptor|Cool|CurrentThreadScheduler|Cursor|Date|DateTime|Dateish|Deprecation|Distribution|Distribution::Hash|Distribution::Locally|Distribution::Path|Distribution::Resource|Distribution::Resources|Distro|Duration|Encoding|Encoding::Builtin|Encoding::Decoder|Encoding::Decoder::Builtin|Encoding::Encoder|Encoding::Encoder::Builtin|Encoding::Encoder::TranslateNewlineWrapper|Encoding::Registry|Endian|Enumeration|Exception|Exceptions|Exceptions::JSON|Failure|FatRat|FileChangeEvent|Format|Formatter|Formatter::Syntax|Grammar|HardRoutine|Hash|Hash::Object|Hash::Ordered|Hash::Typed|HyperSeq|HyperWhatever|IO|IO::ArgFiles|IO::CatHandle|IO::Handle|IO::Notification|IO::Notification::Change|IO::Path|IO::Path::Cygwin|IO::Path::Parts|IO::Path::QNX|IO::Path::Spec|IO::Path::Unix|IO::Path::Win32|IO::Pipe|IO::Socket|IO::Socket::Async|IO::Socket::Async::ListenSocket|IO::Socket::Async::Port-Number|IO::Socket::INET|IO::Spec|IO::Spec::Cygwin|IO::Spec::QNX|IO::Spec::Unix|IO::Spec::Win32|IO::Special|Instant|Int|IntStr|Iterable|IterationBuffer|Iterator|JSONException|Junction|Kernel|Label|List|Lock|Lock::Async|Lock::ConditionVariable|Lock::Soft|Macro|Map|Match|Metamodel|Metamodel::Archetypes|Metamodel::ClassHOW|Metamodel::CoercionHOW|Metamodel::ConcreteRoleHOW|Metamodel::Configuration|Metamodel::CurriedRoleHOW|Metamodel::DefiniteHOW|Metamodel::EnumHOW|Metamodel::GenericHOW|Metamodel::GrammarHOW|Metamodel::ModuleHOW|Metamodel::NativeHOW|Metamodel::NativeRefHOW|Metamodel::PackageHOW|Metamodel::ParametricRoleGroupHOW|Metamodel::ParametricRoleHOW|Metamodel::Primitives|Metamodel::SubsetHOW|Method|MethodDispatcher|Mix|MixHash|Mixy|Mu|MultiDispatcher|NFC|NFD|NFKC|NFKD|Nil|Num|NumStr|Numeric|NumericEnumeration|NumericStringyEnumeration|ObjAt|Operator|OperatorProperties|Order|Pair|ParallelSequence|Parameter|Perl|Pod|Pod::Block|Pod::Block::Code|Pod::Block::Comment|Pod::Block::Declarator|Pod::Block::Input|Pod::Block::Named|Pod::Block::Output|Pod::Block::Para|Pod::Block::Table|Pod::Config|Pod::Defn|Pod::FormattingCode|Pod::Heading|Pod::Item|Pod::Raw|Positional|PositionalBindFailover|PredictiveIterator|Proc|Proc::Async|Proc::Async::Pipe|Promise|PromiseStatus|ProtocolFamily|ProtocolType|Proxy|PseudoStash|QuantHash|QuantHash::KeyOf|REPL|RaceSeq|Raku|Range|Rat|RatStr|Rational|Real|Regex|Routine|Scalar|Scheduler|SeekType|Semaphore|Seq|Sequence|Set|SetHash|Setty|Signal|Signal::Signally|Signature|SignedBlob|Slang|Slip|SocketType|SoftRoutine|Stash|Str|StrDistance|Stringy|StringyEnumeration|Sub|Submethod|Supplier|Supplier::Preserving|Supply|Systemic|Tap|Tappable|Thread|ThreadPoolScheduler|UInt|Uni|Unicode|UnsignedBlob|VM|ValueObjAt|Variable|Version|Whatever|WhateverCode|WrapDispatcher)\>"
color brightcyan "\<(X|CX|RakuAST)(::[A-Z][[:alnum:]_]*)+"
color brightcyan "\<(CArray|Pointer|OpaquePointer)\>"

# Subs and methods that are capitalised or contain a hyphen
color cyan "\<(DEFINITE|DYNAMIC-FALLBACK|EVAL|EVALFILE|HOW|NYI|REPR|RUN-MAIN|VAR|WHAT|WHERE|WHICH|WHO|atomic-add-fetch|atomic-assign|atomic-dec-fetch|atomic-fetch|atomic-fetch-add|atomic-fetch-dec|atomic-fetch-inc|atomic-fetch-sub|atomic-inc-fetch|atomic-sub-fetch|full-barrier|is-prime|parse-base|parse-names|return-rw|sleep-timer|sleep-until|subbuf-rw|substr-rw|take-rw|trim-leading|trim-trailing)\>"
color cyan "\.[=^?]?(ACCEPTS|ASSIGN-KEY|ASSIGN-POS|AST|AT-KEY|AT-POS|Array|BIND-KEY|BIND-POS|BUILD|BUILDALL|BUILDALLPLAN|BUILDPLAN|BUILD_LEAST_DERIVED|Bag|BagHash|Baggy|Blob|Bool|Bridge|Buf|CALL-ME|CODE|COERCE|CREATE|CURSOR|CWD|Callable|Capture|Channel|Complex|DEFINITE|DELETE-KEY|DELETE-POS|DESTROY|DISTROnames|DUMP|Date|DateTime|EOF|EVAL|EXISTS-KEY|EXISTS-POS|FAILGOAL|FALLBACK|FLATTENABLE_HASH|FLATTENABLE_LIST|Failure|FatRat|HOW|Hash|INSTANTIATE-GENERIC|IO|Instant|Int|IterationBuffer|KERNELnames|List|Map|Mix|MixHash|Mixy|NFC|NFD|NFG|NFKC|NFKD|NOT-ACCEPTS|Num|Numeric|Order|POPULATE|POSITIONS|PRECURSOR|Pair|Promise|READ|REPR|Range|Rat|Real|SET-COMPLAINEE|SETFAIL|SPEC|STORE|STORE_AT_KEY|Seq|Set|SetHash|Setty|Slip|Str|Stringy|Supply|TOP|TWEAK|Tappable|UInt|UPGRADE-RAT|Uni|VAR|VMnames|Version|WHAT|WHERE|WHEREFORE|WHICH|WHO|WHY|WRITE|ZEN-KEY|add-bytes|already-failure|already-success|alternative-names|api-matcher|associative-reversed|at-line|auth-matcher|available-str|await-all|base-repeating|bind-stderr|bind-stdin|bind-stdout|bind-udp|bool-only|bracket-closer-for-opener|bracket-closers|bracket-opener-for-closer|bracket-openers|bytecode-handle|bytecode-size|bytes-available|calling-package|can-install|categorize-list|check-type-compat|child-name|child-typename|classify-list|close-stdin|collation-level|complainee-message|completions-for-line|connect-path|consume-all-chars|consume-available-chars|consume-exactly-bytes|consume-exactly-chars|consume-line-chars|count-only|cpu-cores|cpu-usage|cur-sep|day-fraction|day-of-month|day-of-week|day-of-year|days-in-month|days-in-year|dd-mm-yyyy|delete-by-compiler|did-you-mean|dir-sep|dir-with-entries|directive-filename|dist-id|do-not-close-automatically|empty-range|enclosing-kind|encode-chars|ends-with|error-code|excludes-max|excludes-min|export-how-package|export-package|export-sub|extract-last-word|file-for-spec|filename-real|first-date-in-month|first-none-setting-line|free-memory|from-args|from-iterator|from-list|from-loop|from-posix|from-posix-nanos|from-slurpy|from-slurpy-flat|from-slurpy-onearg|from-type|from-unit|get-await-handle|globalish-package|got-dimensions|has-loop-phasers|has-phaser|has-phasers|hh-mm-ss|history-file|identifier-name|implicit-lexical-usage|in-class-call|in-range|in-timezone|incompat-revisions|input-incomplete|input-toplevel-control|int-bounds|invalid-str|is-absolute|is-compile-time|is-deterministic|is-empty|is-generic|is-hidden|is-implementation-detail|is-initial-thread|is-int|is-item|is-lazy|is-leap-year|is-monotonically-increasing|is-prime|is-relative|is-reserved-operator|is-routine|is-runtime|is-setting|is-type|is-up-to-date|is-win|is-wrapped|julian-date|known-category|lang-rev|language-revision|language-version|last-date-in-month|left-elems|line-real|listen-path|load-precompilation|load-precompilation-file|load-repo-id|load-source|load-source-file|load-unit|lock-type|may-precomp|merge-symbols|meta-file|method-type|mm-dd|mm-dd-yyyy|modified-julian-date|multi-invocant|must-be-resolved|name-for-repository|native-descriptor|needed-dimensions|new-compat|new-from-ctx|new-from-daycount|new-from-pairs|new-from-string|new-repl-eval|new-unit|new-without-check|next-interesting-index|next-repo|next-term|nl-in|nl-out|non-numeric|non-numeric-range|not-reducible|of-type|offset-in-hours|offset-in-minutes|on-close|on-demand|on-switch|os-error|out-buffer|out-of-dynamic-scope|outer-caller-idx|own-up|package-kind|package-name|package-type|param-is-invocant|parent-name|parse-base|parse-names|path-sep|path-spec|peer-host|peer-port|platform-library-name|precomp-ext|precomp-repository|precomp-store|precomp-target|print-nl|print-to|properties-for-group|protect-or-queue-on-recursion|pseudo-package|pty-cols|pty-rows|pull-one|push-all|push-at-least|push-exactly|push-until-lazy|qualifier-type|read-bits|read-int128|read-int16|read-int32|read-int64|read-int8|read-num32|read-num64|read-ubits|read-uint128|read-uint16|read-uint32|read-uint64|read-uint8|reducer-name|register-name|reification-target|remote-debugging|remove-from-cache|repl-eval|repl-loop|repl-print|replace-with|repo-chain|repo-id|repo-name|repository-for-name|repository-for-spec|request-garbage-collection|reserved-operator-hint|reserved-operators-lookup|reset-backtrace|resize-pty|resolve-unknown-repos|return-rw|right-elems|role-name|roles-ordered|routine-type|run-script|save-to|schedule-on|second-part|set-line-separators|set-properties|setup-repositories|short-circuit|short-id|short-name|should-be-concrete|sink-all|skip-at-least|skip-at-least-pull-one|skip-one|slurp-rest|socket-host|socket-port|source-checksum|source-file|source-indicator|source-name|source-package|source-package-name|source-shape|starts-with|store-file|store-repo-id|store-unit|sub-or-precedence|sub-precedence|subbuf-rw|subscribe-awaiter|subst-mutate|substr-eq|substr-rw|supports-op|target-name|target-shape|target-type|to-nanos|to-posix|total-memory|translate-nl|trim-leading|trim-trailing|truncated-to|try-load|type-a|type-b|update-completions|upgrade-repository|usage-name|use-case|use-repository|vault-backtrace|verbose-config|version-matcher|watch-path|week-number|week-year|weekday-of-month|what-endpoint|whole-second|win-verbatim-args|with-lock-hidden-from-recursion-check|write-bits|write-int128|write-int16|write-int32|write-int64|write-int8|write-num32|write-num64|write-to|write-uint128|write-uint16|write-uint32|write-uint64|write-uint8|writeable-path|yyyy-mm|yyyy-mm-dd|zip-latest)\>"
color cyan "\<(MAIN|USAGE|GENERATE-USAGE|RUN-MAIN|BUILD|TWEAK|DESTROY|TOP|explicitly-manage)\>"
color cyan "\<(done-testing|bail-out|skip-rest|cmp-ok|is-deeply|is-approx|use-ok|isa-ok|does-ok|can-ok|dies-ok|lives-ok|eval-dies-ok|eval-lives-ok|throws-like|fails-like|is-run)\>"
color brightmagenta "\<return-rw\>"

# Regex without a prefix. As a slash can also be a division, it only counts
# after ~~, an opening bracket, a comma, "= ", ": ", some keywords between
# spaces, or at the start of a line. Whatever came before it is painted
# again afterwards, which also resets brackets and commas inside the regex.
color magenta "(~~|[(,{]|[=:][[:space:]]|^|(^|[[:space:]])(when|if|elsif|unless|while|until|return|and|or|not|so|grep|split|comb)[[:space:]])[[:space:]]*/([^/\\'"]|\\.|'[^']*'|"[^"]*")+/"
color normal "~~|[=:][[:space:]]|[(){},]"
color normal "(^|[[:space:]])(and|or|not|so)[[:space:]]"
color brightmagenta "(^|[[:space:]])(when|if|elsif|unless|while|until|return)[[:space:]]"
color cyan "(^|[[:space:]])(grep|split|comb)[[:space:]]"
color normal "(^|[[:space:]])(when|if|elsif|unless|while|until|return|and|or|not|so|grep|split|comb)[[:space:]]*=>"

# Regex with a prefix: m/ /, rx/ /, s/ / /, tr/ / /
color magenta "\<(m|rx)(:[[:alnum:]]+)*/([^/\\'"]|\\.|'[^']*'|"[^"]*")*/"
color magenta "\<(s|S|ss|SS|tr|TR)(:[[:alnum:]]+)*/([^/\\'"]|\\.|'[^']*'|"[^"]*")*/([^/\\'"]|\\.|'[^']*'|"[^"]*")*/"

# Sym
color cyan ":sym\>"

# Angle brackets
color green "<[[:alnum:]_./:+*!?@-]([[:alnum:] _./:+*!?@-]*[[:alnum:]_./:+*!?@])?>"
color green "«[^»]*»"
color green "｢[^｣]*｣|「[^」]*」"

# Numbers with a radix
color yellow ":[0-9]+<[[:alnum:]_.]+>"

# Strings. Both kinds are matched by one rule, so that an apostrophe inside
# a double quoted string does not start a single quoted one, and vice versa.
color green ""([^"\\]|\\.)*"|'([^'\\]|\\.)*'"
color green "“[^”]*”"

# Quoting constructs
color green "\<(qq|Q|qw|qqw|qx|qqx)(:[a-z]+)*(\{[^}]*\}|\[[^]]*\]|<[^>]*>|/[^/]*/|\|[^|]*\|)"
color green "\<q(:[a-z]+)*(<[^>]*>|/[^/]*/|\|[^|]*\|)"

# Variables
color red "\$<[[:alnum:]_-]+>"
color red "\$([0-9]+|[/!¢])"
color red "([@%&$]\$|[$@%&])[.!^:*?=~]?[[:alpha:]_][[:alnum:]_]*(['-][[:alpha:]_][[:alnum:]_]*)*"

# Single quoted strings do not interpolate
color green "'([^'"\\]|\\.)*'"

# Comments - single line, including Pod declarator blocks
color brightblue "(^|[[:space:]])#([^`].*|`([^[({<].*)?)?$"

# Comments - embedded / multi line
color brightblue start="#`\(" end="\)"
color brightblue start="#`\[" end="\]"
color brightblue start="#`\{" end="\}"
color brightblue start="#`<" end=">"
color brightblue start="#`\(\(" end="\)\)"
color brightblue start="#`\[\[" end="\]\]"
color brightblue start="#`\{\{" end="\}\}"
color brightblue start="#`<<" end=">>"
color brightblue start="#`｢" end="｣"
color brightblue start="#`「" end="」"

# Pod Declarator blocks - multi line
color brightblue start="#[|=]\(" end="\)"
color brightblue start="#[|=]\[" end="\]"
color brightblue start="#[|=]\{" end="\}"

# Heredocs
color green start="\<(q|qq|Q)(:[a-z]+)*:?(to|heredoc)(:[a-z]+)*/[A-Z][A-Z0-9_]*/" end="^[[:space:]]*[A-Z][A-Z0-9_]*[[:space:]]*$"

# Pod - paragraph and abbreviated blocks, which end at the first blank line
color brightblue start="^[[:space:]]*=(for|head[0-9]*|item[0-9]*|para|code|input|output|defn|comment|table|nested|config|alias|[A-Z]+)\>" end="^[[:space:]]*$"

# Pod - delimited blocks
color brightblue start="^[[:space:]]*=begin\>" end="^[[:space:]]*=end\>.*"
color brightblue start="^[[:space:]]*=begin[[:space:]]+(pod|rakudoc)\>" end="^[[:space:]]*=end[[:space:]]+(pod|rakudoc)\>"

# Pod - everything after =finish
color brightblue start="^=finish\>" end="x^"
