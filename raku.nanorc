##############################################################################
# Raku syntax highlighting for Nano
#
# Author:  Naoum Hankache
# License: GPL 3 or later
#
# Last Modified: 2026-10-10
##############################################################################
#
# How this file works
#
# Nano paints the rules in the order they appear and later rules paint over
# earlier ones, so the order below matters. Its regexes have no lookaround,
# and "-" and "'" count as word boundaries, which Raku identifiers allow.
# Words are therefore painted first, then kebab-case identifiers are reset
# to the normal colour, then the builtins that contain a hyphen are painted.
#
# Only the terminal's own palette is used and plain text is left unpainted,
# so the colours follow the terminal theme, light or dark.
#
# Bold ("bright") is kept for keywords, operators, phasers and builtin
# types, so that they stand out. Comments and Pod are bold too, as plain blue
# is hard to read on a dark background, with Pod headings in bold yellow.

syntax "Raku" "\.raku(mod|doc|test)?$"
header "^#!.*(raku|perl6)" "^[[:space:]]*use v6\>"
comment "#"

# Numbers
color yellow "\<[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?i?\>"
color yellow "\<0(x[0-9A-Fa-f_]+|o[0-7_]+|b[01_]+|d[0-9_]+)\>"
color yellow "\<(pi|tau)\>|π|τ|∞"

# Word operators. The one letter ones only count between spaces, and so do
# the meta-operators made with R, X, Z and S: Z~ X+ R- Zmax
color brightmagenta "\<(after|and|andthen|before|cmp|coll|div|eq|eqv|ff|fff|gcd|ge|gt|lcm|le|leg|lt|mod|ne|not|notandthen|or|orelse|so|unicmp|xor|xx)\>"
color brightmagenta "[[:space:]](x|o|X|Z|[RXZS]+([-+*/%~<>=!|&^?,]+|min|max|minmax|gcd|lcm|and|or|xor|eq|ne|lt|le|gt|ge|cmp|leg|eqv|x|xx|div|mod|o|andthen|orelse))[[:space:]]"

# Subs
color cyan "\<(abs|acos|acosec|acosech|acosh|acotan|acotanh|all|antipairs|any|append|asec|asech|asin|asinh|atan|atan2|atanh|await|bag|callframe|callsame|callwith|cas|categorize|ceiling|chars|chdir|chmod|chomp|chop|chown|chr|chrs|cis|classify|close|codes|comb|combinations|copy|cos|cosec|cosech|cosh|cotan|cotanh|cross|deepmap|defined|die|dir|done|duckmap|dynamic|elems|emit|end|enums|exit|exp|expmod|fail|fc|first|flat|flip|floor|get|getc|gist|grep|head|index|indir|invert|item|join|keys|kv|lastcall|lc|lines|link|list|log|log10|log2|lsb|map|max|min|minmax|mix|mkdir|move|msb|nano|new|nextcallee|nextsame|nextwith|nodemap|none|note|now|one|open|ord|ords|pack|pairs|periods|permutations|pick|pop|pred|prepend|print|printf|produce|prompt|push|put|rand|reduce|rename|repeated|repl|report|reverse|rindex|rmdir|roll|roots|rotate|rotor|round|roundrobin|run|samecase|samemark|samewith|say|sec|sech|set|shell|shift|sign|signal|sin|sinh|sleep|slip|slurp|snap|snapper|snip|snitch|sort|splice|split|sprintf|spurt|sqrt|squish|srand|substr|succ|sum|symlink|tail|take|tan|tanh|tc|tclc|time|trim|truncate|uc|undefine|unimatch|uniname|uninames|uniparse|uniprop|uniprops|unique|unival|unlink|unpack|unpolar|unshift|val|values|warn|wordcase|words|zip)\>"

# Test module
color cyan "\<(diag|flunk|isnt|like|nok|ok|pass|plan|skip|subtest|todo|unlike)\>"

# NativeCall
color cyan "\<(cglobal|nativecast|nativesizeof)\>"
color brightcyan "\<(bool|long|longlong|size_t|ssize_t|ulong|ulonglong|void)\>"

# Native types
color brightcyan "\<(atomicint|blob16|blob32|blob64|blob8|buf16|buf32|buf64|buf8|byte|int|int16|int32|int64|int8|num|num32|num64|str|uint|uint16|uint32|uint64|uint8|utf8)\>"

# Names that are special where they are declared. The declarator is painted
# again by the keywords below.
color cyan "\<(sub|method|submethod|multi|proto|only|token|rule|regex)[[:space:]]+(MAIN|USAGE|BUILD|TWEAK|DESTROY|TOP)\>"

# Keywords
color brightmagenta "\<(also|anon|augment|but|class|constant|default|do|does|eager|else|elsif|enum|for|gather|given|grammar|handles|has|hides|hyper|if|import|is|last|lazy|let|loop|macro|made|make|method|module|multi|my|need|next|no|of|once|only|orwith|our|package|proceed|proto|quietly|race|react|redo|regex|repeat|require|return|returns|role|rule|self|sink|start|state|sub|submethod|subset|succeed|supersede|supply|temp|token|trusts|try|unit|unless|until|use|when|whenever|where|while|will|with|without)\>"

# Traits and pragmas, which only count after "is" and "use" or "no"
color yellow "\<is[[:space:]]+(assoc|built|cached|copy|default|dynamic|encoded|equiv|export|looser|native|nativesize|nodal|pure|raw|readonly|repr|required|rw|symbol|tighter)\>"
color yellow "\<(use|no)[[:space:]]+(experimental|fatal|isms|lib|newline|nqp|precompilation|soft|strict|trace|variables|worries)\>"
color brightmagenta "\<(is|use|no)\>"

# Methods. A name after a dot is none of the words above, but a range is
# not a method call.
color normal "\.\.+|\.[=^?]?[[:alpha:]_][[:alnum:]_]*"
color cyan "\.[=^?]?(abbreviated|abs|abs2rel|absolute|accept|accepts_type|accessed|acos|acosec|acosech|acosh|acotan|acotanh|acquire|act|action|actions|add|add_attribute|add_enum_value|add_fallback|add_method|add_parent|add_private_method|add_role|add_stash|add_trustee|addendum|adverb|after|all|allocate|allof|annotations|antipair|antipairs|any|anyof|api|app_lifetime|append|arch|archetypes|archname|are|args|arity|asec|asech|asin|asinh|assuming|ast|at|atan|atan2|atanh|atoms|attributes|auth|backend|backtrace|base|base_type|basename|batch|before|bits|bless|block|bounds|break|broken|bytes|cache|can|cancel|candidates|cando|canonicalize|canonpath|caps|caption|capture|catdir|categorize|catfile|catpath|cause|ceiling|changed|channel|chars|chdir|child|chmod|chomp|chop|chown|chr|chrs|chunks|cis|classify|cleanup|clear|clone|close|closed|closer|code|codename|codes|coerce_type|collate|colonpairs|column|comb|combinations|command|comment|compiler|composalizer|compose|compose_type|compose_values|composer|compute_mro|concise|condition|config|configure_destroy|configure_type_checking|conj|connect|constraint|constraints|construct|contains|content|contents|copy|cos|cosec|cosech|cosh|cotan|cotanh|count|create_type|created|cross|cue|curdir|curupdir|d|day|daycount|declaration|decode|decoder|deepmap|default|defined|definite|delayed|delegate_methods_to|delegating_methods_to|delete|delimited|denominator|desc|destroyers|details|dev|devnull|devtype|die|dir|directive|directives|dirname|distribution|do|does|done|duckmap|dynamic|e|eager|earlier|elems|emit|enclosing|encode|encoder|encoding|end|endian|enum_from_value|enum_value_list|enum_values|enums|eof|event|exception|exitcode|exp|expected|expmod|export_callback|extension|f|fail|fc|feature|file|filename|files|find|find_method|find_method_qualified|find_private_method|finish|first|flat|flatmap|flip|floor|flush|flush_cache|fmt|for|format|formatter|freeze|from|full|generate_mixin|get|get_value|getc|gist|got|grab|grabpairs|grep|group|handle|handled|handles|hardware|has_accessor|hash|head|headers|hidden|hides|hostname|hour|how|hyper|id|illegal|im|in|indent|index|indices|infinite|infix|inode|install|install_method_cache|instead|interval|invert|invocant|isNaN|is_bound|is_built|is_composed|is_mixin|is_trusted|is_type|isa|item|iterator|join|keep|kept|key|keyof|keys|kill|kv|kxxv|l|lang|last|later|lazy|lc|leading|letter|level|line|lines|link|list|listen|live|load|loaded|loads|local|lock|log|log10|log2|lookup|lsb|made|make|map|match|max|maxpairs|merge|message|meta|method|method_table|methods|migrate|min|minmax|minpairs|minute|misplaced|mixin|mixin_attribute|mkdir|mode|modified|modifier|month|move|mro|mro_unhidden|msb|multi|multiness|my|name|named|named_names|narrow|need|new|new_type|next|nice|nodemap|nominalize|none|norm|not|note|now|nude|numerator|of|offset|old|one|open|opened|opener|operation|optional|ord|ords|orig|osname|package|packages|pair|pairs|pairup|paragraphs|parameter|parameterize_type|params|parent|parents|parse|parsefile|parts|path|payload|periods|perl|permutations|phaser|pick|pickpairs|pid|placeholder|plus|polar|poll|polymod|pop|pos|positional|posix|postfix|postmatch|precompiled|pred|prefix|prematch|prepend|pretend_to_be|pretending_to_be|primary|print|printf|private|private_method_names|private_method_table|private_methods|proc|produce|promise|protect|pty|publish_method_cache|push|put|quaternary|quit|r|race|radix|raku|rand|range|raw|re|read|readchars|readonly|ready|reallocate|reals|reason|rebless|receive|recv|redispatcher|redo|reduce|rel2abs|relative|release|remove|rename|repeated|replacement|repo|report|required|reserved|resolve|restore|result|resume|rethrow|return|returns|reverse|right|rindex|rmdir|role|roles_to_compose|rolish|roll|rootdir|roots|rotate|rotor|round|roundrobin|run|rw|rwx|s|samecase|samemark|samespace|say|scheduler|scope|sec|sech|second|secondary|seek|self|send|serial|set|set_api|set_auth|set_composalizer|set_export_callback|set_hidden|set_is_mixin|set_mixin_attribute|set_name|set_package|set_parameterizer|set_rw|set_value|set_ver|set_why|setup_finalization|setup_mixin_cache|shape|share|shell|shift|shortname|sibling|sigil|sign|signal|signals|signature|signatures|sin|sinh|sink|skip|slice|slurp|slurpy|smiley|snap|snapper|snip|snitch|so|sort|source|spawn|splice|split|splitdir|splitpath|sprintf|spurt|sqrt|squish|stable|start|started|status|stderr|stdout|sub_signature|subbuf|subname|subparse|subst|substr|succ|suffix|sum|summary|symbol|symlink|t|tail|take|tan|tanh|tap|target|tc|tclc|tell|term|tertiary|then|throttle|throw|timezone|tmpdir|to|today|toggle|total|trailing|traits|trans|tree|trim|truncate|trusts|try_acquire|trying|twigil|type|type_captures|type_check|type_parameter_at|type_parameterized|type_parameters|typename|uc|udp|uncaught_handler|unimatch|uniname|uninames|uninstall|uniparse|uniprop|unique|unival|univals|unlink|unlock|unpack|unpolar|unset|unshift|unwrap|updir|user|using|utc|val|value|values|variable|ver|version|volume|vow|w|wait|watch|week|what|when|where|why|wordcase|words|workaround|wrap|write|x|yada|year|yield|z|zip)\>"

# Versions
color yellow "\<v[0-9]+(\.([0-9]+|\*|[a-z]\>))*(\.PREVIEW\>)?\+?"

# Kebab-case identifiers are not any of the words above
color normal "(\.[=^?]?)?[[:alpha:]_][[:alnum:]_]*(['-][[:alpha:]_][[:alnum:]_]*)+"

# Neither are named arguments and pair keys
color normal ":!?[[:alpha:]_][[:alnum:]_-]*"
color normal "\<[[:alpha:]_][[:alnum:]_'-]*[[:space:]]*=>"

# Phasers
color brightmagenta "\<(BEGIN|CATCH|CHECK|CLOSE|CONTROL|DOC|END|ENTER|FIRST|INIT|KEEP|LAST|LEAVE|NEXT|POST|PRE|QUIT|TEMP|UNDO)\>"

# Capitalised and hyphenated traits and pragmas
color yellow "\<(DEPRECATED|dynamic-scope|hidden-from-backtrace|implementation-detail|test-assertion)\>"

# Booleans and other terms
color yellow "\<(True|False|Empty|Inf|NaN)\>"

# Builtin types. Types that are not builtin are left unpainted.
color brightcyan "\<(AST|Allomorph|Any|Array|Associative|Attribute|Backtrace|Bag|BagHash|Baggy|Blob|Block|Bool|Buf|CallFrame|Callable|Cancellation|Capture|Channel|Code|Collation|CompUnit|Compiler|Complex|ComplexStr|Cool|CurrentThreadScheduler|Date|DateTime|Dateish|Distribution|Distro|Duration|Encoding|Endian|Enumeration|Exception|Failure|FatRat|FileChangeEvent|ForeignCode|Format|Formatter|Grammar|Hash|HyperSeq|HyperWhatever|IO|Instant|Int|IntStr|Iterable|IterationBuffer|Iterator|Junction|Kernel|Label|List|Lock|Macro|Map|Match|Method|Mix|MixHash|Mixy|Mu|NFC|NFD|NFKC|NFKD|Nil|Num|NumStr|Numeric|ObjAt|Order|Pair|Parameter|Perl|Positional|PositionalBindFailover|PredictiveIterator|Proc|Promise|PromiseStatus|Proxy|PseudoStash|QuantHash|RaceSeq|Raku|RakuAST|Range|Rat|RatStr|Rational|Real|Regex|Routine|Scalar|Scheduler|Semaphore|Seq|Sequence|Set|SetHash|Setty|Signal|Signature|Slip|Stash|Str|StrDistance|Stringy|Sub|Submethod|Supplier|Supply|Systemic|Tap|Telemetry|Test|Thread|ThreadPoolScheduler|UInt|Uni|Unicode|VM|ValueObjAt|Variable|Version|Whatever|WhateverCode)\>"
# A name with a namespace is one name, so that the Str of My::Str is not
# painted; then the builtin types that have a namespace.
color normal "\<[A-Z][[:alnum:]_]*(::[[:alpha:]_][[:alnum:]_]*)+"
color brightcyan "\<(Backtrace::Frame|Distribution::Hash|Distribution::Locally|Distribution::Path|Distribution::Resource|Encoding::Decoder|Encoding::Encoder|Encoding::Registry|IO::ArgFiles|IO::CatHandle|IO::Handle|IO::Notification|IO::Notification::Change|IO::Path|IO::Path::Cygwin|IO::Path::Parts|IO::Path::QNX|IO::Path::Unix|IO::Path::Win32|IO::Pipe|IO::Socket|IO::Socket::Async|IO::Socket::Async::ListenSocket|IO::Socket::INET|IO::Spec|IO::Spec::Cygwin|IO::Spec::QNX|IO::Spec::Unix|IO::Spec::Win32|IO::Special|Lock::Async|Lock::ConditionVariable|Pod::Block|Pod::Block::Code|Pod::Block::Comment|Pod::Block::Declarator|Pod::Block::Named|Pod::Block::Para|Pod::Block::Table|Pod::Defn|Pod::FormattingCode|Pod::Heading|Pod::Item|Proc::Async|Routine::WrapHandle|Supplier::Preserving)\>"
color brightcyan "\<(X|CX|RakuAST|Metamodel|CompUnit|Telemetry)(::[A-Z][[:alnum:]_]*)+"
color brightcyan "\<(CArray|Pointer)\>"

# Type smileys: Int:D, Str:U, Any:_ but not the D of Some::D
color brightcyan ":[DU_]\>"
color normal "::[DU_]\>"

# Subs and methods that are capitalised or contain a hyphen
color normal "\.\.+|\.[=^?]?[A-Z][[:alnum:]_-]*"
color cyan "\<(ARGS-TO-CAPTURE|DEFINITE|EVAL|EVALFILE|GENERATE-USAGE|HOW|REPR|RUN-MAIN|VAR|WHAT|WHERE|WHICH|WHO|WHY|atomic-assign|atomic-dec-fetch|atomic-fetch|atomic-fetch-add|atomic-fetch-dec|atomic-fetch-inc|atomic-fetch-sub|atomic-inc-fetch|full-barrier|is-prime|parse-base|parse-names|sleep-timer|sleep-until|subbuf-rw|substr-rw|take-rw|trim-leading|trim-trailing)\>"
color cyan "\.[=^?]?(ACCEPTS|ASSIGN-KEY|ASSIGN-POS|AST|AT-KEY|AT-POS|Array|BIND-KEY|BIND-POS|BUILD|Bag|BagHash|Baggy|Blob|Bool|Bridge|Buf|CALL-ME|CODE|CREATE|Callable|Capture|Channel|Complex|DEFINITE|DELETE-KEY|DELETE-POS|DESTROY|DISTROnames|Date|DateTime|EOF|EVAL|EXISTS-KEY|EXISTS-POS|FALLBACK|Failure|FatRat|HOW|Hash|IO|Instant|Int|KERNELnames|List|Map|Mix|MixHash|Mixy|NFC|NFD|NFG|NFKC|NFKD|Num|Numeric|Order|Pair|Promise|READ|REPR|Range|Rat|Real|SPEC|STORE|Seq|Set|SetHash|Setty|Slip|Str|Stringy|Supply|T|TWEAK|UInt|VAR|VMnames|Version|WHAT|WHERE|WHEREFORE|WHICH|WHO|WHY|WRITE|add-atom|add-colonpair|add-config|add-leading|add-meta|add-paragraph|add-trailing|allowed-markup|alternative-names|base-name|base-repeating|base-type|bind-stderr|bind-stdin|bind-stdout|bind-udp|bool-only|build-date|bytecode-size|calling-package|categorize-list|child-name|child-typename|classify-list|close-stdin|connect-path|count-only|cpu-cores|cpu-usage|cut-WHY|day-fraction|day-of-month|day-of-week|day-of-year|days-in-month|days-in-year|dd-mm-yyyy|delete-by-compiler|did-you-mean|dir-sep|dir-with-entries|ends-with|excludes-max|excludes-min|first-colonpair|first-date-in-month|first-part|free-memory|from-identifier|from-identifier-parts|from-list|from-loop|from-paragraphs|from-posix|from-slurpy|has-colonpair|has-colonpairs|hh-mm-ss|in-range|in-timezone|int-bounds|invalid-str|is-absolute|is-anonymous|is-coercive|is-deterministic|is-empty|is-global-lookup|is-hidden|is-identifier|is-implementation-detail|is-indirect-lookup|is-initial-thread|is-installable|is-int|is-lazy|is-leap-year|is-monotonically-increasing|is-multi-part|is-native|is-package-lookup|is-package-search|is-prime|is-pseudo-package|is-relative|is-routine|is-setting|is-simple|is-win|is-wrapped|julian-date|last-date-in-month|last-part|listen-path|literalize-config|load-repo-id|load-unit|mm-dd-yyyy|modified-julian-date|multi-invocant|native-descriptor|new-from-daycount|new-from-pairs|new-unit|next-handle|next-interesting-index|nl-in|nl-out|offset-in-hours|offset-in-minutes|on-close|on-switch|os-error|out-buffer|outer-caller-idx|package-kind|package-name|parent-name|parse-base|parse-names|path-sep|peer-host|peer-port|precomp-ext|precomp-target|print-nl|print-to|protect-or-queue-on-recursion|pull-one|push-all|push-at-least|push-exactly|push-until-lazy|qualifier-type|read-bits|read-int128|read-int16|read-int32|read-int64|read-int8|read-num32|read-num64|read-ubits|read-uint128|read-uint16|read-uint32|read-uint64|read-uint8|replace-with|repo-id|request-garbage-collection|resize-pty|resolved-config|return-rw|root-part|routine-type|schedule-on|set-WHEREFORE|set-WHY|set-atoms|set-config|set-instruments|set-leading|set-level|set-margin|set-meta|set-paragraphs|set-trailing|set-type|short-id|short-name|simple-identifier|sink-all|skip-at-least|skip-at-least-pull-one|skip-one|slurp-rest|socket-host|socket-port|source-package|starts-with|store-file|store-repo-id|store-unit|subbuf-rw|subst-mutate|substr-eq|substr-rw|target-name|to-posix|total-memory|trim-leading|trim-trailing|truncated-to|usage-name|verbose-config|watch-path|week-number|week-year|weekday-of-month|whole-second|with-lock-hidden-from-recursion-check|without-colonpair|without-first-part|write-bits|write-int128|write-int16|write-int32|write-int64|write-int8|write-num32|write-num64|write-to|write-ubits|write-uint128|write-uint16|write-uint32|write-uint64|write-uint8|yyyy-mm-dd|zip-latest)\>"
color cyan "\<(explicitly-manage)\>"
color cyan "\<(bail-out|can-ok|cmp-ok|dies-ok|does-ok|done-testing|eval-dies-ok|eval-lives-ok|exits-ok|fails-like|is-approx|is-approx-calculate|is-deeply|isa-ok|lives-ok|skip-rest|throws-like|use-ok)\>"
color brightmagenta "\<(HAS|return-rw)\>"
color yellow "\<MONKEY(-[A-Z]+)*\>"

# Z=> is a meta-operator, not a pair key
color brightmagenta "[[:space:]][RXZ]=>[[:space:]]"

# Reduction meta-operators: [+] [\*] [Z+] and, after a space, [*] [max] [Zmax].
# A character class such as <[+-]> is not one.
color brightmagenta "\[\\?[RXZS]*[-+*/%~<>=!|&^?,]*[-+/%~<>=!|&^?,][-+*/%~<>=!|&^?,]*\]"
color brightmagenta "(^|[[:space:]])\[\\?[RXZS]*(\*\*?|min|max|minmax|gcd|lcm|and|or|xor|eq|ne|lt|le|gt|ge|cmp|leg|eqv|x|xx|div|mod|o|andthen|orelse)\]"
color normal "<[-+]?\[[^]]*\]>"

# Regex without a prefix. As a slash can also be a division, it only counts
# after ~~, an opening bracket, a comma, "= ", ": ", some keywords between
# spaces, or at the start of a line. Whatever came before it is painted
# again afterwards, which also resets brackets and commas inside the regex.
color magenta "(~~|[(,{]|[=:][[:space:]]|^|(^|[[:space:]])(when|if|elsif|unless|while|until|return|and|or|not|so|grep|split|comb)[[:space:]])[[:space:]]*/([^/\\'"]|\\.|'[^']*'|"[^"]*"|<[-+]?\[[^]]*\]>)+/"
color normal "~~|[=:][[:space:]]|[(){},]"
color brightmagenta "(^|[[:space:]])(when|if|elsif|unless|while|until|return|and|or|not|so)[[:space:]]"
color cyan "(^|[[:space:]])(grep|split|comb)[[:space:]]"
color normal "(^|[[:space:]])(when|if|elsif|unless|while|until|return|and|or|not|so|grep|split|comb)[[:space:]]*=>"

# Regex with a prefix: m/ /, rx/ /, s/ / /, tr/ / /, and in brackets: m{ },
# rx[ ], s:g[ ], s{ } = . Without an adverb s[ ] needs the "=" to count, as
# it is an index otherwise.
color magenta "\<(m|rx)(:[[:alnum:]]+)*(\{([^}\\'"]|\\.|'[^']*'|"[^"]*")*\}|\[([^]<\\'"]|\\.|'[^']*'|"[^"]*"|<[^>]*>)*\])"
color magenta "\<(s|S|ss|SS)(:[[:alnum:]]+)+(\{([^}\\'"]|\\.|'[^']*'|"[^"]*")*\}|\[([^]<\\'"]|\\.|'[^']*'|"[^"]*"|<[^>]*>)*\])"
color magenta "\<(s|S|ss|SS)(\{([^}\\'"]|\\.|'[^']*'|"[^"]*")*\}|\[([^]<\\'"]|\\.|'[^']*'|"[^"]*"|<[^>]*>)*\])[[:space:]]*=[[:space:]]"
color magenta "\<(m|rx)(:[[:alnum:]]+)*/([^/\\'"]|\\.|'[^']*'|"[^"]*"|<[-+]?\[[^]]*\]>)*/"
color magenta "\<(s|S|ss|SS|tr|TR)(:[[:alnum:]]+)*/([^/\\'"]|\\.|'[^']*'|"[^"]*"|<[-+]?\[[^]]*\]>)*/([^/\\'"]|\\.|'[^']*'|"[^"]*"|<[-+]?\[[^]]*\]>)*/"

# Sym
color cyan ":sym\>"

# Angle brackets
color green "<[[:alnum:]_./:+*!?@-]([[:alnum:] _./:+*!?@-]*[[:alnum:]_./:+*!?@])?>"
# A hyper operator is matched here too, so that its « does not open a list
color green "(»|«|>>|<<)[-+*/%~=!|&^?<>]*[-+*/%~=!|&^?](»|«|>>|<<)|«[^»]*»"
color green "｢[^｣]*｣|「[^」]*」"

# Hyper operators: >>+<< »+« >>.method
color brightmagenta "(»|«|>>|<<)[-+*/%~=!|&^?<>]*[-+*/%~=!|&^?](»|«|>>|<<)"
color brightmagenta "(»|>>)\."

# Numbers with a radix
color yellow ":[0-9]+<[[:alnum:]_.]+>"

# Strings. Both kinds are matched by one rule, so that an apostrophe inside
# a double quoted string does not start a single quoted one, and vice versa.
color green ""([^"\\]|\\.)*"|'([^'\\]|\\.)*'"
color green "“[^”]*”|„[^“”]*[“”]"

# Quoting constructs
color green "\<(q|qq|Q)(w|ww|x)?(:[a-z]+)*(\{\{([^}]|\}[^}])*\}\}|\[\[([^]]|\][^]])*\]\]|<<([^>]|>[^>])*>>|\{[^}]*\}|\[[^]]*\]|<[^>]*>|/[^/]*/|\|[^|]*\||![^!]*!)"

# A subscript on something called q, m or s is not a quote or a regex
color normal "([$@%&][.!^:*?=~]?|[.:'-])(q|qq|Q|m|rx|s|S|ss|SS)(w|ww|x)?(\{[^}]*\}|\[[^]]*\])"

# Variables
color red "\$<[[:alnum:]_-]+>"
color red "\$([0-9]+|[/!¢])"
color red "([@%&$]\$|[$@%&])[.!^:*?=~]?[[:alpha:]_][[:alnum:]_]*(['-][[:alpha:]_][[:alnum:]_]*)*"

# Single quoted strings do not interpolate
color green "'([^'"\\]|\\.)*'"
color green "‘[^’]*’|‚[^‘’]*[‘’]"
# Neither do q and Q after a space, nor ｢ ｣
color green "(^|[[:space:]])(q|Q)(w|ww|x)?(\{\{([^}]|\}[^}])*\}\}|\[\[([^]]|\][^]])*\]\]|<<([^>]|>[^>])*>>|\{[^}]*\}|\[[^]]*\]|<[^>]*>|/[^/]*/|\|[^|]*\||![^!]*!)"
color green "｢[^｣]*｣"

# Comments - single line, including Pod declarator blocks
color brightblue "(^|[[:space:];)}])#([^`].*|`([^[({<].*)?)?$"

# Comments - embedded / multi line
color brightblue start="#`\(" end="\)"
color brightblue start="#`\[" end="\]"
color brightblue start="#`\{" end="\}"
color brightblue start="#`<" end=">"
color brightblue start="#`\(\(" end="\)\)"
color brightblue start="#`\[\[" end="\]\]"
color brightblue start="#`\{\{" end="\}\}"
color brightblue start="#`<<" end=">>"
color brightblue start="#`｢" end="｣"
color brightblue start="#`「" end="」"

# Pod Declarator blocks - multi line
color brightblue start="#[|=]\(" end="\)"
color brightblue start="#[|=]\[" end="\]"
color brightblue start="#[|=]\{" end="\}"

# Heredocs. An end cannot refer to its start, so the usual terminators have
# a rule each, and any other one in capitals ends at the first line that is
# a word in capitals. A terminator also counts after a "#" or a "\n", which
# closes the heredocs of code that is commented out or inside a string, as
# does one before a closing bracket or quote. An opener directly before a
# quote does not count.
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/END/([^'"]|$)" end="^[[:space:]#]*END([[:space:]]*$|[]})'"])|\\n[[:space:]]*END\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/EOF/([^'"]|$)" end="^[[:space:]#]*EOF([[:space:]]*$|[]})'"])|\\n[[:space:]]*EOF\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/EOT/([^'"]|$)" end="^[[:space:]#]*EOT([[:space:]]*$|[]})'"])|\\n[[:space:]]*EOT\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/EOS/([^'"]|$)" end="^[[:space:]#]*EOS([[:space:]]*$|[]})'"])|\\n[[:space:]]*EOS\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/CODE/([^'"]|$)" end="^[[:space:]#]*CODE([[:space:]]*$|[]})'"])|\\n[[:space:]]*CODE\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/SOURCE/([^'"]|$)" end="^[[:space:]#]*SOURCE([[:space:]]*$|[]})'"])|\\n[[:space:]]*SOURCE\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/TEXT/([^'"]|$)" end="^[[:space:]#]*TEXT([[:space:]]*$|[]})'"])|\\n[[:space:]]*TEXT\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/HERE/([^'"]|$)" end="^[[:space:]#]*HERE([[:space:]]*$|[]})'"])|\\n[[:space:]]*HERE\>"
color green start="\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/[A-Z][A-Z0-9_]*/([^'"]|$)" end="^[[:space:]#]*[A-Z][A-Z0-9_]*([[:space:]]*$|[]})'"])|\\n[[:space:]]*[A-Z][A-Z0-9_]*\>"
# What follows the opener on its line is code, not a part of the heredoc.
# A string or a comment there keeps the colour it has, which is the same.
color normal "\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/[A-Z][A-Z0-9_]*/[^'"#]*"
color green "\<(q|qq|Q)(:!?[a-z]+)*:(to|heredoc)(:!?[a-z]+)*/[A-Z][A-Z0-9_]*/"

# Pod - paragraph and abbreviated blocks, which end at the first blank line
color brightblue start="^[[:space:]]*=(for|head[0-9]*|item[0-9]*|para|code|input|output|defn|comment|table|nested|config|alias|[A-Z]+)\>" end="^[[:space:]]*$"

# Pod - delimited blocks
color brightblue start="^[[:space:]]*=begin\>" end="^[[:space:]]*=end\>.*"
color brightblue start="^[[:space:]]*=begin[[:space:]]+(pod|rakudoc)\>" end="^[[:space:]]*=end[[:space:]]+(pod|rakudoc)\>"

# Pod - everything after =finish
color brightblue start="^=finish\>" end="x^"

# Pod - headings, and formatting codes after a space: B<bold> C<code> L<link>
color brightyellow "^[[:space:]]*=(head[0-9]*|TITLE|SUBTITLE)[[:space:]].*"
color brightblue "^[[:space:]]*=(head[0-9]*|TITLE|SUBTITLE)\>"
color cyan "(^|[[:space:]])[BCEIKLMNPRTUVXZ](<<([^>]|>[^>])*>>|<[^<>]*>|«[^»]*»)"
