##############################################################################
# Raku syntax highlighting for Nano
#
# Author:  Naoum Hankache
# License: GPL 3 or later
#
# Last Modified: 2026-10-05
##############################################################################
#
# How this file works
#
# Nano paints the rules in the order they appear and later rules paint over
# earlier ones, so the order below matters. Its regexes have no lookaround,
# and "-" and "'" count as word boundaries, which Raku identifiers allow.
# Words are therefore painted first, then kebab-case identifiers are reset
# to the normal colour, then the builtins that contain a hyphen are painted.
#
# Only the terminal's own palette is used and plain text is left unpainted,
# so the colours follow the terminal theme, light or dark.
#
# Bold ("bright") is kept for keywords, phasers and builtin types, so that
# they stand out. Comments are bold too, as plain blue is hard to read on a
# dark background.

syntax "Raku" "\.(raku(mod|doc|test)?|p[lm]?6|pod6|t6)$"
header "^#!.*(raku|perl6)" "^[[:space:]]*use v6\>"
comment "#"

# Numbers
color yellow "\<[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?i?\>"
color yellow "\<0(x[0-9A-Fa-f_]+|o[0-7_]+|b[01_]+|d[0-9_]+)\>"
color yellow "\<(pi|tau)\>|π|τ|∞"

# Subs
color cyan "\<(abs|acos|acosec|acosech|acosh|acotan|acotanh|all|any|append|asec|asech|asin|asinh|atan|atan2|atanh|await|bag|cache|callframe|callsame|callwith|cas|categorize|ceiling|chars|chdir|chmod|chomp|chop|chown|chr|chrs|cis|classify|close|comb|combinations|copy|cos|cosec|cosech|cosh|cotan|cotanh|cross|deepmap|defined|die|dir|done|duckmap|elems|emit|end|exit|exp|expmod|fail|fc|first|flat|flip|floor|get|getc|gist|goto|grep|hash|head|index|indices|indir|item|join|keys|kv|last|lastcall|lc|leave|lines|link|list|log|log10|log2|lsb|make|map|max|min|minmax|mix|mkdir|move|msb|next|nextcallee|nextsame|nextwith|nodemap|none|note|one|open|ord|ords|pair|pairs|permutations|pick|pop|prepend|print|printf|proceed|produce|prompt|push|put|rand|redo|reduce|rename|repeated|repl|return|reverse|rindex|rmdir|roll|roots|rotate|rotor|round|roundrobin|run|samecase|samemark|samewith|say|sec|sech|set|shell|shift|sign|signal|sin|sinh|skip|sleep|slip|slurp|snip|snitch|sort|splice|split|sprintf|spurt|sqrt|squish|srand|substr|succeed|sum|symlink|tail|take|tan|tanh|tc|tclc|trans|trim|truncate|uc|unimatch|uniname|uninames|uniparse|uniprop|uniprops|unique|unival|univals|unlink|unpolar|unshift|val|values|warn|wordcase|words|zip)\>"

# Test module
color cyan "\<(plan|todo|skip|diag|subtest|pass|flunk|ok|nok|isnt|like|unlike)\>"

# NativeCall
color cyan "\<(cglobal|nativecast|nativesizeof)\>"
color brightcyan "\<(long|longlong|ulong|ulonglong|size_t|ssize_t|bool|void)\>"

# Native types
color brightcyan "\<(array|atomicint|byte|int|int16|int32|int64|int8|num|num32|num64|str|uint|uint16|uint32|uint64|uint8|utf16|utf32|utf8)\>"

# Keywords
color brightmagenta "\<(my|our|has|state|let|temp|anon|augment|supersede|constant|enum|subset|unit|class|role|grammar|module|package|sub|method|submethod|multi|proto|only|macro|token|rule|regex|is|does|but|of|returns|handles|trusts|hides|also|will|where|use|no|need|import|require|if|elsif|else|unless|with|orwith|without|for|given|when|default|loop|while|until|repeat|do|try|gather|start|react|whenever|supply|once|quietly|lazy|eager|hyper|race|sink|return|proceed|succeed|last|next|redo|make|made|self)\>"

# Traits and pragmas, which only count after "is" and "use" or "no"
color yellow "\<is[[:space:]]+(rw|readonly|copy|raw|required|built|export|default|dynamic|pure|nodal|native|nativesize|symbol|encoded|repr|tighter|looser|equiv|assoc|cached)\>"
color yellow "\<(use|no)[[:space:]]+(experimental|fatal|internals|invocant|isms|lib|newline|nqp|precompilation|soft|strict|trace|variables|worries)\>"
color brightmagenta "\<(is|use|no)\>"

# Methods
color cyan "\.[=^?]?(abs|abs2rel|absolute|abspath|accept|accessed|acos|acosec|acosech|acosh|acotan|acotanh|acquire|act|action|actions|add|add_attribute|add_conc_to_cache|add_concretization|add_enum_value|add_fallback|add_meta_method|add_method|add_multi_method|add_multi_methods|add_parent|add_phaser|add_private_method|add_role|add_stash|add_trustee|addendum|additional|adverb|after|after_scan|aggregate|alias|all|all_method_table|allocate|allof|allowed|alnum|alpha|alternative|alternatives|ambiguous|andthen|annotations|antipair|antipairs|any|anyof|api|app_lifetime|append|apply_handles|arch|archetypes|archname|are|arg|arg0|args|arguments|arity|array_type|asec|asech|asin|asinh|assoc|associative|assuming|ast|at|atan|atan2|atanh|attribute|attribute_table|attributes|auth|available|await|backend|backlog|backtrace|base|basename|batch|before|big|bits|blank|bless|block|body_block|boundary|bounds|braid|branch|break|broken|byte|bytecode|bytes|c3_merge|cache|cache_add|cache_get|call|callable_for_phaser|callframe|callsites|can|cancel|cancelled|candidates|cando|canonpath|caps|caption|capture|catdir|categorize|category|catfile|catpath|cause|ceiling|chain|changed|channel|char|characters|chars|chdir|check|check_LANG_oopsies|check_PACKAGE_oopsies|checkee_eqaddr_list|checkee_istype_list|checksum|child|chmod|chomp|chop|chown|chr|chrs|chunks|circumfix|cis|class|classify|cleanup|clear|clone|clone_braid_from|close|closed|closer|cntrl|code|code_of_method|codename|codes|coerce_type|collate|column|comb|combinations|combinator|command|comment|compiler|complainee|composalize|compose|compose_attributes|compose_meta_methods|compose_repr|compose_values|composer|compute_mro|concise|concretization|concretization_lookup|concretizations|condition|config|configuration|configure_punning|conj|connect|constraint|constraint_list|constraints|construct|container|containerized|contains|content|contents|copy|cos|cosec|cosech|cosh|cotan|cotanh|could_not_instantiate|count|create_BUILDPLAN|created|ctxsave|cue|curdir|curupdir|d|day|daycount|dba|decl|declaration|declarator|declares_method|declaring|decode|decoder|deepmap|default|define_slang|defined|delayed|delete|denominator|dependencies|desc|deserialize|destination|destroyers|details|dev|devnull|devtype|die|diffy|digit|dim|dimensions|dir|directive|directives|dirname|disallowed|dispatcher|dist|distribution|do|does|done|duckmap|dump|dynamic|e|eager|earlier|elems|emit|enc|enclosing|encode|encoder|encoding|end|endian|endpoint|enum_from_value|enum_value_list|enum_values|enums|eof|equiv|err|evaluate_unquotes|event|exception|exceptions|exclude_parent|exitcode|exp|expected|expectedn|explain|expmod|extension|extensions|f|fail|family|fc|feature|fiddly|file|filename|files|find|find_method|find_method_fallback|find_method_qualified|find_private_method|finish|fire_if_phasers|fire_phasers|first|flags|flat|flatmap|flavor|flip|floor|flush|flush_cache|fmt|for|format|formatter|found|freeze|from|from1|from2|full|generate_mixin|get|get_attribute_for_usage|get_boolification_mode|get_cached_conc|get_container_spec|get_default_parent_type|get_value|getc|gid|gist|gistseen|goal|got|gotn|goto|grab|grabpairs|grammar|graph|grep|group|handle|handle_uncaught|handled|handles|hardware|has_attribute|has_default_parent_type|has_fallbacks|has_multi_candidate|has_public_attribute|hash|head|headers|hidden|hides|hides_parent|highexpect|hint|host|hostname|hour|how|hyper|id|ident|idx|iffy|illegal|im|implicit|in|incarnate|incorporate_multi_candidates|indent|index|indices|inf|infinite|infix|inheritalize|init|inlined|inner|inode|ins_roles|install|installed|instantiate_generic|instead|int|int16|int32|int64|int8|interactive_prompt|interval|invalidate_method_caches|invalidate_mro_cache|invert|invocant|isNaN|is_array_type|is_composed|is_default_generic|is_generic|is_method_call_punned|is_mixin|is_pun|is_quasi_ast|is_trusted|isa|item|iterator|join|keep|kept|key|keyof|keys|keyword|kill|kind|kinds|know_how|kv|kxxv|l|lang|language_revision|last|later|lazy|lc|leading|leave|left|level|line|lines|link|list|list_istype_checkee|listen|listening|literal|live|load|loaded|loads|local|localhost|localizer|localport|lock|locprepost|log|log10|log2|lookup|looser|lower|lsb|macro|made|make|make_pun|map|match|max|max_threads|maxpairs|maybe|merge|mess|message|meta|meta_method_table|meta_methods|metachar|method|method_names|method_not_implemented|method_order|method_table|methods|migrate|min|minmax|minpairs|minus|minute|misplaced|missing|mixin|mixin_attribute|mixin_base|mkdir|mode|modified|modifier|modifiers|modules|month|move|mro|mro_unhidden|msb|multi|multi_methods_to_incorporate|multiness|my|name|named|named_names|nameds|narrow|native|need|needparens|needs|new|new_type|next|nice|no_single_attribute|nodemap|nogo|nomark|nominal_type|nominalizable|none|norm|not|not_composable|note|now|nude|num|numerator|object|objname|of|offset|old|omitted|one|onearg|op|open|opened|opener|operation|operator|opname|optional|options|ord|ords|orelse|orig|osname|out|out_of_range|outer|package|package_at_key|packages|pair|pairs|pairup|panic|param|parameter|parameterize|params|parent|parents|parse|parsefile|parts|path|payload|perl|perlseen|permutations|phaser|phasers|pick|pickpairs|pid|placeholder|plus|polar|poll|polymod|pop|pop_role_to_compose|port|pos|positional|posix|post|post_types|postcircumfix|postfix|postmatch|pragma|pre|prec|precedence|precision|precompile|precompiled|pred|prefix|prefixes|prematch|prepend|pretend_to_be|pretending_to_be|primary|print|printf|priors|private|private_method_names|private_method_table|private_methods|proc|process|produce|promise|protect|proto|protoguilt|prune|pty|publish_boolification_spec|publish_container_spec|publish_method_cache|publish_type_cache|pun|pun_repr|pun_source|punct|push|put|quaternary|queue|quit|r|race|radix|raku|rakuseen|rand|range|raw|re|read|readchars|readlink|readonly|ready|reallocate|reals|reason|receive|recursing|recv|redispatcher|redo|reduce|reducer|refine_slang|register|rel2abs|relative|release|remove|removed|rename|r